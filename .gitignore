# Secrets — MUST be ignored before the first commit (CLAUDE.md golden rule)
.env

# Virtual environments
.venv/
venv/
env/

# Raw downloaded data (USGS/ECCC) and API logs are gitignored.
# data/ is partitioned by VARIABLE first (data/turbidity/, data/specific_conductance/)
# and by approval status second: approved/ holds the clean bases src.datasets.inject
# globs, provisional/ is audit scratch. Everything a pull can regenerate from NWIS is
# ignored; the injected datasets beside them are hand-generated ground truth and stay
# tracked. (Ignore contents but allow the .gitkeep/README files below back in.)
data/turbidity/approved/**
data/turbidity/provisional/**
# Provisional-vs-approved comparison pulls (regenerate: `python -m src.datasets.pull_comparison`)
data/turbidity/comparison/**
# Nearby rainfall (regenerate: `python -m src.datasets.pull_precip <gauge>`) — §7.7
data/turbidity/precip/**
# Specific conductance (regenerate: `python -m src.datasets.pull_usgs --variable
# specific_conductance` and `... --provisional-set`) — §9.6. No injected datasets
# exist for it yet; when they do they belong beside these, tracked, like turbidity's.
data/specific_conductance/**
# Legacy 15-min raw pulls, retired when the project moved to 5-min bases.
data/legacy_15min/raw/**
logs/*

# Keep the gitignored directories in the tree
!data/turbidity/.gitkeep
!data/turbidity/approved/
!data/turbidity/approved/.gitkeep
!data/turbidity/comparison/README.md
!data/specific_conductance/
!data/specific_conductance/approved/
!data/specific_conductance/approved/.gitkeep
!data/specific_conductance/provisional/
!data/specific_conductance/provisional/.gitkeep
!logs/.gitkeep

# Generated review artifacts (regenerate via `python -m src.workbench.visualize`)
figures/

# Proposed candidates are regenerable from the series (`src.workbench.review detect`).
# The reviewed *labels* are hand-made ground truth — those stay in the repo.
data/review/*_candidates.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Agent run artefacts (cleaned CSV + report). Regenerable by re-running the
# agent; the JSONL log they came from is gitignored above.
data/agent_runs/

# 5-min gauge screening scratch (scratchpad/screen_5min_*.py). The national
# series-catalog dump (~230MB) and the per-site probe cache (~255MB) are
# regenerable from NWIS; the small screening RESULT tables beside them are not
# ignored, since they are the evidence for the §9 gauge choice.
scratchpad/out/screen_5min_catalog.csv
scratchpad/out/probe5/

# Agent RUN artefacts parked in the scratchpad while comparing runs (runT/U/V).
# Same rule as data/agent_runs/ above: regenerable by re-running the agent, and
# the flag log + cleaned CSV are tens of MB. The small tuning RESULT tables
# beside them (*.txt, the tune_*/screen_* CSVs) are evidence and stay tracked.
scratchpad/out/run*_flags.json
scratchpad/out/run*_clean.csv
scratchpad/out/*.log

# Working notes dropped in for discussion — not project artefacts.
markdowns/*
# ...except the agent change log, which is a project artefact (CLAUDE.md §14).
!markdowns/agent_changelog.md
